# App repo: React frontend (frontend/) and Python backend (backend/)

# Secrets and local configuration (never commit)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
service-account*.json
*-credentials.json
.secrets/
*.token

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/

# Editors and operating systems
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

